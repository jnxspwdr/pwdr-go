# --- Local Postgres (used by docker-compose.yml) ---------------------------
# Local dev-only credentials for the throwaway docker-compose container —
# nothing production-facing ever reads these, so the defaults below are fine
# to use as-is.
POSTGRES_DB=pwdr_go
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres

# Must match the three values above (host/port come from docker-compose.yml).
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pwdr_go

# --- better-auth -------------------------------------------------------------
# Random string used to sign session tokens/cookies. Generate your own with:
#   bunx @better-auth/cli secret
# then paste the output here (a base64 string, e.g. `Kx7f...Qm2=`). Never
# reuse someone else's value for this — it's a secret, not a config knob.
BETTER_AUTH_SECRET=

# Must match the origin the app is actually served from. Next defaults to
# port 3000, but check for a PORT env var overriding that — if this doesn't
# match, better-auth rejects browser sign-in with an "invalid origin" error.
BETTER_AUTH_URL=http://localhost:3000

# --- Seed data (src/data/seed.ts) --------------------------------------------
# Optional — pins the faker seed so `bun run generate` produces the same
# fake orgs/users/tickets every run. Omit for a fresh random seed each time
# (whichever seed is used gets logged to the console either way).
# ENV_FAKER_SEED=12345
